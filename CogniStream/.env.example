# CogniStream Environment Configuration

# Service Settings
COGNISTREAM_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-cognistream-platform-change-in-production

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=cognistream
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# Analytics & Methodology Configuration
# Qualification threshold: focus blocks >= this duration are marked as "qualifying" focus
FOCUS_QUALIFICATION_THRESHOLD_MINUTES=90.0

# Session reconstruction: inactivity gap greater than this splits IDE heartbeats into new sessions
SESSION_INACTIVITY_THRESHOLD_MINUTES=15.0

# Estimated context switching recovery times (minutes) by interruption category
RECOVERY_MINUTES_CI_CD=12.0
RECOVERY_MINUTES_DIRECT_MESSAGE=15.0
RECOVERY_MINUTES_MENTION=10.0
RECOVERY_MINUTES_CHANNEL_MESSAGE=5.0
RECOVERY_MINUTES_PROJECT_SWITCH=18.0
RECOVERY_MINUTES_TASK_SWITCH=10.0
RECOVERY_MINUTES_DEFAULT=10.0

# Ingestion & Data Generation
MOCK_DATA_MODE=true
SYNTHETIC_DATA_DAYS=30
RANDOM_SEED=42

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api